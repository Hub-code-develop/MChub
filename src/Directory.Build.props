<Project>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsLinuxBuildHost>$([MSBuild]::IsOSPlatform('Linux'))</IsLinuxBuildHost>
        <IsX64BuildHost Condition="$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture) == 'X64'">true</IsX64BuildHost>
        <TargetsLinux Condition="'$(RuntimeIdentifier)' == 'linux-x64' Or ('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == 'linux-x64')">true</TargetsLinux>
        <TargetsLinux Condition="'$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '' And '$(IsLinuxBuildHost)' == 'true' And '$(IsX64BuildHost)' == 'true'">true</TargetsLinux>
    </PropertyGroup>

    <!-- dotnet restore -r osx-arm64 只会设置 RuntimeIdentifiers（复数），只有构建时的 -p:RuntimeIdentifier= 才设置单数，
         两处都要判定，否则 restore 阶段 MChub.Bedrock.MacOS 不进入还原图，构建时就会报 NETSDK1004。 -->
    <PropertyGroup Condition="$(RuntimeIdentifier.Contains('osx')) Or ('$(RuntimeIdentifier)' == '' And $(RuntimeIdentifiers.Contains('osx')))">
        <DefineConstants>MACOS</DefineConstants>
        <UseMauiEssentials>false</UseMauiEssentials>
        <TargetsMacOS>true</TargetsMacOS>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetsLinux)' == 'true'">
        <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
    </PropertyGroup>
</Project>
