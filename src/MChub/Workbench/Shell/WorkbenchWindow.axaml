<Window
    x:Class="MChub.Workbench.Shell.WorkbenchWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MChub"
    Width="1440"
    Height="900"
    MinWidth="1000"
    MinHeight="640"
    ExtendClientAreaToDecorationsHint="True"
    ExtendClientAreaTitleBarHeightHint="30"
    RequestedThemeVariant="Dark"
    Classes="workbench"
    Background="{DynamicResource WbEditorBg}">
    <!--
        布局参照 Visual Studio 2022（深色主题）：
        1) 顶部只有两行 —— 标题栏（含菜单）和一条操作条，没有独立工具栏区；
        2) 没有左右图标竖条。VS 的工具窗口靠菜单 / 快捷键唤出，不常驻在屏幕边上；
        3) 每个工具窗口自带标题栏，与内容同底色，靠留白分层而不是分隔线；
        4) 编辑器标签是方角、紧凑的，激活标签与编辑区同色连成一片；
        5) 状态栏是品牌紫 #68217A。
        克制是这套设计的关键：能不用线就不用线，能不摆按钮就不摆。
    -->

    <Window.Styles>
        <!--
            工作台用系统 UI 字体，不用项目全局的圆体（AlimamaFangYuanTi）。
            圆体偏"消费级"，放在代码编辑器式的界面里会显得不专业；
            VS 这类工具一律是系统等线体。中文优先苹方，英文走系统 UI 字体。
        -->
        <Style Selector="Window.workbench TextBlock">
            <Setter Property="FontFamily" Value="PingFang SC, Microsoft YaHei UI, Segoe UI, Helvetica Neue" />
        </Style>

        <!--  菜单项：矮、方角、悬停浅灰  -->
        <Style Selector="Button.wb-menu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource WbFg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wb-menu:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3E3E40" />
        </Style>

        <!--  通用扁按钮：树行、面包屑  -->
        <Style Selector="Button.wb-flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource WbFg}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wb-flat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource WbHoverBg}" />
        </Style>

        <!--  面板标题栏里的小图标  -->
        <Style Selector="Button.wb-tool-action">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wb-tool-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3E3E40" />
        </Style>

        <!--  操作条上的按钮（实例切换 / 运行）  -->
        <Style Selector="Button.wb-action">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource WbFg}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wb-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3E3E40" />
        </Style>

        <!--  状态栏上的条目：悬停时比背景亮一点点，不抢眼  -->
        <Style Selector="Button.wb-widget">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.wb-widget:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF" />
        </Style>

        <Style Selector="Border.wb-tab:pointerover">
            <Setter Property="Background" Value="#323233" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="30,*,22">
        <!--  ── 标题栏：品牌 + 菜单 + 当前实例 + 运行 + 右侧图标，只有一行  ──  -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource WbTitleBarBg}"
            ColumnDefinitions="78,Auto,Auto,*,Auto,Auto,Auto">
            <TextBlock
                Grid.Column="1"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{DynamicResource WbFg}"
                Text="MChub" />
            <StackPanel
                x:Name="MenuStrip"
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="ToolbarProject"
                Grid.Column="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="ToolbarRun"
                Grid.Column="5"
                Margin="4,0,6,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
            <StackPanel
                x:Name="TitleBarRight"
                Grid.Column="6"
                Margin="0,0,6,0"
                VerticalAlignment="Center"
                Orientation="Horizontal" />
        </Grid>

        <!--  ── 主体：左面板 / 编辑区 / 右面板  ──  -->
        <Grid x:Name="MainArea" Grid.Row="1" ColumnDefinitions="272,4,*,4,272">
            <!--  左侧工具窗口：标题栏与内容同底色，不用分隔线  -->
            <Grid
                x:Name="LeftToolWindow"
                Grid.Column="0"
                RowDefinitions="32,*">
                <Grid
                    Margin="12,0,6,0"
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Name="LeftToolTitle"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource WbFg}" />
                    <StackPanel
                        x:Name="LeftToolActions"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
                </Grid>
                <ContentControl x:Name="LeftToolHost" Grid.Row="1" />
            </Grid>

            <GridSplitter
                x:Name="LeftSplitter"
                Grid.Column="1"
                Background="Transparent"
                ResizeDirection="Columns" />

            <!--  编辑区 + 底部工具窗口  -->
            <Grid x:Name="EditorArea" Grid.Column="2" RowDefinitions="34,*,4,148">
                <!--  编辑器标签条：方角、激活标签与编辑区连成一片（所以这里不画分隔线）  -->
                <Border Grid.Row="0" Background="{DynamicResource WbTabStripBg}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel
                                x:Name="TabStrip"
                                Height="33"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal" />
                        </ScrollViewer>
                        <Button
                            x:Name="InspectionWidget"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Classes="wb-action"
                            FontSize="11"
                            ToolTip.Tip="问题" />
                    </Grid>
                </Border>

                <Panel Grid.Row="1" Background="{DynamicResource WbEditorBg}">
                    <ContentControl x:Name="EditorHost" />
                    <StackPanel
                        x:Name="EmptyState"
                        Margin="0,0,0,48"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{DynamicResource WbIconFont}"
                            FontSize="30"
                            Foreground="#3F3F46"
                            Text="&#xe651;" />
                        <TextBlock
                            x:Name="EmptyTitle"
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource WbFgMuted}" />
                        <TextBlock
                            x:Name="EmptyHint"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource WbFgFaint}" />
                    </StackPanel>
                </Panel>

                <GridSplitter
                    x:Name="PanelSplitter"
                    Grid.Row="2"
                    Background="{DynamicResource WbBorder}"
                    ResizeDirection="Rows" />

                <!--  底部工具窗口：标签直接长在标题栏上  -->
                <Grid
                    x:Name="BottomToolWindow"
                    Grid.Row="3"
                    RowDefinitions="30,*"
                    Background="{DynamicResource WbPanelBg}">
                    <Border
                        Background="{DynamicResource WbToolHeaderBg}"
                        BorderBrush="{DynamicResource WbBorder}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel
                                x:Name="PanelTabs"
                                Margin="6,0,0,0"
                                Orientation="Horizontal" />
                            <StackPanel
                                x:Name="PanelTools"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal" />
                        </Grid>
                    </Border>
                    <ContentControl x:Name="PanelHost" Grid.Row="1" />
                </Grid>
            </Grid>

            <GridSplitter
                x:Name="RightSplitter"
                Grid.Column="3"
                Background="Transparent"
                ResizeDirection="Columns" />

            <!--  右侧工具窗口：默认收起，按需唤出  -->
            <Grid
                x:Name="RightToolWindow"
                Grid.Column="4"
                RowDefinitions="32,*"
                IsVisible="False">
                <Grid
                    Margin="12,0,6,0"
                    ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Name="RightToolTitle"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource WbFg}" />
                    <StackPanel
                        x:Name="RightToolActions"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal" />
                </Grid>
                <ContentControl x:Name="RightToolHost" Grid.Row="1" />
            </Grid>
        </Grid>

        <!--  ── 状态栏（品牌紫）  ──  -->
        <Border Grid.Row="2" Background="{DynamicResource WbStatusBg}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel
                    x:Name="StatusLeft"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
                <StackPanel
                    x:Name="StatusRight"
                    Grid.Column="1"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal" />
            </Grid>
        </Border>

        <!--  ── 命令面板  ──  -->
        <Border
            x:Name="PaletteOverlay"
            Grid.RowSpan="3"
            Background="#8C000000"
            IsVisible="False">
            <Border
                Width="640"
                Margin="0,72,0,0"
                VerticalAlignment="Top"
                Background="{DynamicResource WbSidebarBg}"
                BorderBrush="#5A5A5F"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel>
                    <TextBox
                        x:Name="PaletteInput"
                        Margin="12,9"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13" />
                    <Border Height="1" Background="{DynamicResource WbBorder}" />
                    <ScrollViewer MaxHeight="360">
                        <StackPanel
                            x:Name="PaletteList"
                            Margin="4" />
                    </ScrollViewer>
                    <Border
                        Padding="10,5"
                        Background="{DynamicResource WbToolHeaderBg}"
                        BorderBrush="{DynamicResource WbBorder}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,4,4">
                        <TextBlock
                            x:Name="PaletteFooter"
                            FontSize="10"
                            Foreground="{DynamicResource WbFgFaint}" />
                    </Border>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
