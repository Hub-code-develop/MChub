<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/hub-code-develop/MChub</RepositoryUrl>
        <Description>MChub</Description>
        <PackageIcon>..\..\assets\MChub.png</PackageIcon>
        <PackageProjectUrl>https://github.com/hub-code-develop/MChub</PackageProjectUrl>
        <PackageTags>MChub</PackageTags>
        <PackageVersion>0.0.0</PackageVersion>
        <Copyright>https://github.com/hub-code-develop/MChub</Copyright>
        <Authors>github.com/hub-code-develop/MChub</Authors>
        <ApplicationIcon>..\..\assets\MChub.ico</ApplicationIcon>
        <Title>MChub</Title>
        <!-- 本机没有可用的 Avalonia XAML 编译器时改走运行时解析；
             CI 上若显式指定了该属性则以 CI 为准。 -->
        <EnableAvaloniaXamlCompilation Condition="'$(EnableAvaloniaXamlCompilation)' == ''">false</EnableAvaloniaXamlCompilation>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**"/>
        <EmbeddedResource Include="..\..\assets\conf\WikiEntries.txt">
            <Link>Assets\WikiEntries.txt</Link>
        </EmbeddedResource>
        <AvaloniaResource Include="..\..\assets\MChub.ico" Link="Assets/MChub.ico"/>
        <AvaloniaResource Include="..\..\assets\MChub.png" Link="Assets/MChub.png"/>
        <AvaloniaResource Include="..\..\assets\MChub.icns" Link="Assets/MChub.icns"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia"/>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.AvaloniaEdit"/>
        <PackageReference Include="Avalonia.Controls.ItemsRepeater"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <PackageReference Include="Avalonia.Markup.Xaml.Loader" PrivateAssets="All" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="CodeHub-FluentUI"/>
        <PackageReference Include="HotAvalonia" Condition="'$(Configuration)' == 'Debug'"/>
        <PackageReference Include="Irihi.Lingua"/>
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="Tomlyn"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\module\Tio.Avalonia.Standard\src\Tio.Avalonia.Standard.Tab\Tio.Avalonia.Standard.Tab.csproj"/>
        <ProjectReference Include="..\..\module\Tio.Avalonia.Standard\src\Tio.Avalonia.Standard\Tio.Avalonia.Standard.csproj"/>
        <ProjectReference Include="..\MChub.Localization\MChub.Localization.csproj"/>
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>
    
</Project>
