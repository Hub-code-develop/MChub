<UserControl
    x:Class="MChub.Views.Components.ResourceSearchSkeleton"
    xmlns="https://github.com/avaloniaui"
    xmlns:components="clr-namespace:MChub.Views.Components"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsRepeater ItemsSource="{x:Static components:ResourceSearchSkeleton.Items}" Margin="0,0,10,0">
        <ItemsRepeater.Layout>
            <UniformGridLayout
                ItemsStretch="Fill"
                MinColumnSpacing="16"
                MinItemHeight="117"
                MinItemWidth="340"
                MinRowSpacing="16" />
        </ItemsRepeater.Layout>
        <ItemsRepeater.ItemTemplate>
            <DataTemplate>
                <Border
                    Background="{DynamicResource TranslucentBackgroundColor}"
                    BorderBrush="{DynamicResource TranslucentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="10">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <fa:FASkeleton
                                CornerRadius="0"
                                DockPanel.Dock="Left"
                                Height="56"
                                IsActive="True"
                                IsLoading="True"
                                Width="56" />
                            <StackPanel
                                Margin="10,1,0,0"
                                Spacing="5"
                                VerticalAlignment="Center">
                                <fa:FASkeleton
                                    CornerRadius="0"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    IsActive="True"
                                    IsLoading="True"
                                    Width="150" />
                                <fa:FASkeleton
                                    CornerRadius="0"
                                    Height="12"
                                    HorizontalAlignment="Left"
                                    IsActive="True"
                                    IsLoading="True"
                                    Width="105" />
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <fa:FASkeleton
                                        CornerRadius="0"
                                        Height="17"
                                        HorizontalAlignment="Left"
                                        IsActive="True"
                                        IsLoading="True"
                                        Width="52" />
                                    <fa:FASkeleton
                                        CornerRadius="0"
                                        Height="17"
                                        HorizontalAlignment="Left"
                                        IsActive="True"
                                        IsLoading="True"
                                        Width="40" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel Margin="3,5,3,0" Spacing="5">
                            <fa:FASkeleton
                                CornerRadius="0"
                                Height="12"
                                HorizontalAlignment="Stretch"
                                IsActive="True"
                                IsLoading="True" />
                            <fa:FASkeleton
                                CornerRadius="0"
                                Height="12"
                                HorizontalAlignment="Left"
                                IsActive="True"
                                IsLoading="True"
                                Width="190" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ItemsRepeater.ItemTemplate>
    </ItemsRepeater>
</UserControl>
