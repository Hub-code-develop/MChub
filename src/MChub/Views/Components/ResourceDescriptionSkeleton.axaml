<UserControl
    x:Class="MChub.Views.Components.ResourceDescriptionSkeleton"
    xmlns="https://github.com/avaloniaui"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="2,2,12,0" Spacing="10">
        <fa:FASkeleton CornerRadius="0" Height="20" IsActive="True" IsLoading="True" Width="210" />
        <fa:FASkeleton CornerRadius="0" Height="14" HorizontalAlignment="Stretch" IsActive="True" IsLoading="True" />
        <fa:FASkeleton CornerRadius="0" Height="14" HorizontalAlignment="Stretch" IsActive="True" IsLoading="True" />
        <fa:FASkeleton CornerRadius="0" Height="14" IsActive="True" IsLoading="True" Width="520" />
        <fa:FASkeleton CornerRadius="0" Height="18" IsActive="True" IsLoading="True" Margin="0,10,0,0" Width="160" />
        <fa:FASkeleton CornerRadius="0" Height="14" HorizontalAlignment="Stretch" IsActive="True" IsLoading="True" />
        <fa:FASkeleton CornerRadius="0" Height="14" HorizontalAlignment="Stretch" IsActive="True" IsLoading="True" />
        <fa:FASkeleton CornerRadius="0" Height="14" IsActive="True" IsLoading="True" Width="440" />
        <fa:FASkeleton CornerRadius="0" Height="110" HorizontalAlignment="Stretch" IsActive="True" IsLoading="True" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
