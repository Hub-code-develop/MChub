<UserControl
    d:DesignHeight="600"
    d:DesignWidth="960"
    mc:Ignorable="d"
    x:Class="MChub.Views.Pages.ToolsPages.MultiplayerPages.PlayitMultiplayerPage"
    x:DataType="multiplayerPages:PlayitMultiplayerViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:MChub.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:multiplayerPages="clr-namespace:MChub.Views.Pages.ToolsPages.MultiplayerPages"
    xmlns:tio="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="15">

        <!-- 不支持的平台提示 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            IsVisible="{Binding ShowUnsupported}"
            Padding="15">
            <StackPanel
                Margin="2,0,0,0"
                Orientation="Horizontal"
                Spacing="12">
                <TextBlock
                    FontFamily="{StaticResource IconFont}"
                    FontSize="22"
                    Text="&#xe61f;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitMultiplayer}}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Margin="0,3,0,0"
                        Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitComponentMissingTitle}}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 简介 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            Padding="15">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock
                        FontFamily="{StaticResource IconFont}"
                        FontSize="24"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Text="&#xe620;" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitMultiplayer}}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{DynamicResource InnerForegroundColor}"
                            Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitPoweredBy}}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitDesc}}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 下载内核 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            IsVisible="{Binding ShowDownloadCard}"
            Padding="15">
            <StackPanel Spacing="12">
                <StackPanel Margin="2,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitComponentMissingTitle}}" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Margin="0,3,0,0"
                        Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitDesc}}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ProgressBar
                    IsVisible="{Binding IsDownloading}"
                    Maximum="100"
                    Value="{Binding DownloadProgress}" />
                <Button
                    Command="{Binding DownloadKernelCommand}"
                    Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitDownloadCore}}"
                    HorizontalAlignment="Left"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding !IsDownloading}" />
            </StackPanel>
        </Border>

        <!-- 错误提示 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource ErrorBrush}"
            BorderThickness="1"
            CornerRadius="0"
            IsVisible="{Binding HasError}"
            Padding="15">
            <StackPanel Spacing="6">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource ErrorBrush}"
                    Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitStatusError}}" />
                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Text="{Binding ErrorMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 密钥与启停 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            IsVisible="{Binding BinaryInstalled}"
            Padding="15">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <Label
                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitSecretLabel}}"
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Padding="0" />
                    <TextBox
                        PasswordChar="*"
                        IsEnabled="{Binding !IsAgentConnected}"
                        Margin="0,4,0,0"
                        PlaceholderText="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitSecretPlaceholder}}"
                        Text="{Binding SecretKey}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitSecretHint}}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- 状态 -->
                <Border
                    Background="{DynamicResource TranslucentBackgroundColor}"
                    BorderBrush="{DynamicResource TranslucentBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="0"
                    Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock
                            FontFamily="{StaticResource IconFont}"
                            FontSize="20"
                            Foreground="{DynamicResource SystemAccentColor}"
                            Text="{Binding StatusIcon}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{Binding StatusText}" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource InnerForegroundColor}"
                                IsVisible="{Binding HasOfflineReason}"
                                Text="{Binding OfflineReasonSummary}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Command="{Binding StartCommand}"
                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitStartService}}"
                        IsEnabled="{Binding CanStart}"
                        IsVisible="{Binding !IsAgentConnected}" />
                    <Button
                        Command="{Binding StopCommand}"
                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitStopService}}"
                        IsVisible="{Binding IsAgentConnected}" />
                    <Button
                        Command="{Binding RefreshTunnelsCommand}"
                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitRefreshTunnels}}"
                        IsEnabled="{Binding CanRefresh}" />
                    <Button
                        Click="OpenDashboard_OnClick"
                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitOpenDashboard}}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 隧道列表 -->
        <Border
            Background="{DynamicResource TranslucentBackgroundColor}"
            BorderBrush="{DynamicResource TranslucentBorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            IsVisible="{Binding ShowTunnels}"
            Padding="15">
            <StackPanel Spacing="12">
                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitTunnelHeader}}" />

                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    IsVisible="{Binding ShowNoTunnels}"
                    Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitNoTunnels}}"
                    TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Tunnels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="multiplayerPages:PlayitTunnelViewModel">
                            <Border
                                Background="{DynamicResource TranslucentBackgroundColor}"
                                BorderBrush="{DynamicResource TranslucentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Margin="0,0,0,8"
                                Padding="12">
                                <DockPanel>
                                    <Button
                                        Click="CopyTunnelAddress_OnClick"
                                        CommandParameter="{Binding Address}"
                                        Content="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitCopyAddress}}"
                                        DockPanel.Dock="Right"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <StackPanel Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="{Binding KindLabel}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{DynamicResource InnerForegroundColor}"
                                                Text="{Binding LocalPortText}" />
                                        </StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource InnerForegroundColor}"
                                            Margin="0,2,0,0"
                                            Text="{Translate {x:Static loc:CommonLanguageManager+Keys.multiplayer_playitTunnelPublicAddress}}" />
                                        <TextBlock
                                            FontSize="17"
                                            FontWeight="SemiBold"
                                            Margin="0,2,0,0"
                                            Text="{Binding Address}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>