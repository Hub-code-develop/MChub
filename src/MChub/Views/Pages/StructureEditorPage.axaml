<UserControl
    x:Class="MChub.Views.Pages.StructureEditorPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock
                x:Name="FileText"
                FontWeight="SemiBold"
                Text="未打开结构文件"
                VerticalAlignment="Center" />
            <Button Click="Browse" Content="打开…" />
            <Button Click="SaveAs" Content="另存为…" />
            <ComboBox x:Name="RendererBox" MinWidth="220" />
            <Button x:Name="RotateLeftButton" Click="RotateLeft" Content="左转" />
            <Button x:Name="RotateRightButton" Click="RotateRight" Content="右转" />
            <Button x:Name="ZoomInButton" Click="ZoomIn" Content="放大" />
            <Button x:Name="ZoomOutButton" Click="ZoomOut" Content="缩小" />
        </StackPanel>

        <Grid
            Grid.Row="1"
            Margin="0,10,0,0"
            ColumnDefinitions="300,*">
            <StackPanel Spacing="8">
                <TextBlock Opacity="0.7" Text="方块类型（选中后替换）" />
                <ListBox x:Name="BlockList" Height="380" />
                <TextBlock Margin="0,6,0,0" Opacity="0.7" Text="替换为（方块 id）" />
                <TextBox x:Name="TargetBox" Watermark="minecraft:stone" />
                <Button Click="ReplaceSelected" Content="替换选中类型" />
                <TextBlock
                    x:Name="StatusText"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Column="1"
                Margin="12,0,0,0"
                Background="#11000000"
                CornerRadius="8">
                <ContentControl x:Name="RendererHost" />
            </Border>
        </Grid>

        <TextBlock
            x:Name="FootText"
            Grid.Row="2"
            Margin="0,8,0,0"
            Opacity="0.65"
            TextWrapping="Wrap"
            Text="渲染器可替换：新增一个 IStructureRendererFactory 并注册，就会出现在上面的下拉框里。" />
    </Grid>
</UserControl>
