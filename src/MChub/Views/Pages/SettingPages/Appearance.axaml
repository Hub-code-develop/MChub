<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MChub.Views.Pages.SettingPages.Appearance"
    x:DataType="settingPages:Appearance"
    xmlns="https://github.com/avaloniaui"
    xmlns:const1="clr-namespace:MChub.Core.Const;assembly=MChub.Core"
    xmlns:controls="clr-namespace:MChub.Controls"
    xmlns:converter="clr-namespace:MChub.Module.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:lingua="https://irihi.tech/lingua"
    xmlns:loc="using:MChub.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:MChub.Views.Pages.SettingPages"
    xmlns:ui="using:InfinityUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <converter:BackgroundModeCompareConverter x:Key="BackgroundModeCompareConverter" />
    </UserControl.Resources>
    <StackPanel Spacing="15">
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_language}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <lingua:CulturePicker
                CultureChanged="OnCultureChanged"
                Cultures="{Binding Cultures}"
                Managers="{Binding Managers}"
                Theme="{StaticResource CulturePickerTheme}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Label
                        Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_appScale}}"
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        HorizontalAlignment="Left" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="  (" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Binding AppScale, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                        VerticalAlignment="Center" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text=")" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Margin="12,0,0,0"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_effectiveScale}}" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource InnerForegroundColor}"
                        Text="{Binding EffectiveScale, StringFormat={}{0:P0}}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    Spacing="12"
                    VerticalAlignment="Center">
                    <HyperlinkButton
                        Click="ApplyScale_OnClick"
                        Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_applyChanges}}"
                        FontSize="13"
                        Name="ApplyScaleButton"
                        Theme="{StaticResource TransparentHyperlinkButton}" />
                    <HyperlinkButton
                        Click="CustomScale_OnClick"
                        Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_customScale}}"
                        FontSize="13"
                        Theme="{StaticResource TransparentHyperlinkButton}" />
                </StackPanel>
            </DockPanel>
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    IsSnapToTickEnabled="True"
                    Maximum="5.0"
                    Minimum="0.5"
                    Name="AppScaleSlider"
                    TickFrequency="0.25"
                    Value="{Binding AppScale, Source={x:Static const1:Data.ConfigEntry}, Mode=OneWay}"
                    ValueChanged="AppScaleSlider_OnValueChanged" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding #AppScaleSlider.Value, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundStyle}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox HorizontalAlignment="Stretch" SelectedIndex="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}}">
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundDefault}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundImage}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundSolidColor}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundAcrylic}}" />

                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundMica}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundTransparent}}" />
            </ComboBox>
        </StackPanel>
        <!-- 沉浸底：渐变可调色，或退化为单色 -->
        <StackPanel Spacing="5">
            <Label
                Content="沉浸底使用渐变"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding LauncherXBackdropUseGradient, Source={x:Static const1:Data.ConfigEntry}}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="仅在背景风格为「默认」时生效。想要自己的图片背景，把上面的背景风格改成「图片」并选一张图即可。"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="5" IsVisible="{Binding LauncherXBackdropUseGradient, Source={x:Static const1:Data.ConfigEntry}}">
            <Label
                Content="渐变起点色（左上）"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <SelectableTextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                HorizontalAlignment="Right"
                Text="{Binding LauncherXBackdropStartColor, Source={x:Static const1:Data.ConfigEntry}}" />
            <controls:FluentColorPicker
                Color="{Binding LauncherXBackdropStartColor, Source={x:Static const1:Data.ConfigEntry}}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
            <Label
                Content="渐变终点色（右下）"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}"
                Margin="0,8,0,0" />
            <SelectableTextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                HorizontalAlignment="Right"
                Text="{Binding LauncherXBackdropEndColor, Source={x:Static const1:Data.ConfigEntry}}" />
            <controls:FluentColorPicker
                Color="{Binding LauncherXBackdropEndColor, Source={x:Static const1:Data.ConfigEntry}}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel Spacing="5" IsVisible="{Binding !LauncherXBackdropUseGradient, Source={x:Static const1:Data.ConfigEntry}}">
            <Label
                Content="沉浸底单色"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <SelectableTextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                HorizontalAlignment="Right"
                Text="{Binding LauncherXBackdropSolidColor, Source={x:Static const1:Data.ConfigEntry}}" />
            <controls:FluentColorPicker
                Color="{Binding LauncherXBackdropSolidColor, Source={x:Static const1:Data.ConfigEntry}}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <!-- UI 磨砂玻璃：不随背景模式变化，任何模式都可生效；改动实时绑定配置 -->
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_surfaceAcrylic}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding EnableSurfaceAcrylic, Source={x:Static const1:Data.ConfigEntry}}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_surfaceAcrylicDescription}}"
                TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel IsVisible="{Binding EnableSurfaceAcrylic, Source={x:Static const1:Data.ConfigEntry}}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_surfaceAcrylicOpacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding SurfaceAcrylicOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding SurfaceAcrylicOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='SolidColor'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.BackgroundSolidColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Image'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_backgroundImageLabel}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <TextBlock
                FontSize="12"
                Foreground="{DynamicResource InnerForegroundColor}"
                Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_recentBackgrounds}}" />
            <ScrollViewer
                HorizontalScrollBarVisibility="Auto"
                IsVisible="{Binding HasBackgroundHistory}"
                PointerWheelChanged="BackgroundHistory_OnPointerWheelChanged"
                VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding BackgroundHistory}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settingPages:BackgroundHistoryItem">
                            <Border
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="2"
                                ClipToBounds="True"
                                CornerRadius="0"
                                Height="86"
                                PointerPressed="BackgroundHistoryItem_OnPointerPressed"
                                Tag="{Binding}"
                                Width="146">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="RemoveBackgroundHistoryItem_OnClick"
                                            CommandParameter="{Binding}"
                                            Header="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_removeBackgroundFromHistory}}">
                                            <MenuItem.Icon>
                                                <TextBlock
                                                    FontFamily="{StaticResource IconFont}"
                                                    FontSize="16"
                                                    FontWeight="Thin"
                                                    Text="&#xe640;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Border ClipToBounds="True" CornerRadius="0">
                                    <Image Source="{Binding Preview}" Stretch="UniformToFill" />
                                </Border>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button
                Click="ChangeBackgroundImage_OnClick"
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_changeBackgroundImage}}"
                HorizontalAlignment="Left"
                Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Image'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_imageBlurRadius}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding ImageBlurRadius, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding ImageBlurRadius, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Image'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_enableImageMask}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding EnableImageMask, Source={x:Static const1:Data.ConfigEntry}}" />
        </StackPanel>
        <StackPanel Spacing="5">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding
                        Converter="{StaticResource BackgroundModeCompareConverter}"
                        ConverterParameter="Image"
                        Path="BackgroundMode"
                        Source="{x:Static const1:Data.ConfigEntry}" />
                    <Binding Path="EnableImageMask" Source="{x:Static const1:Data.ConfigEntry}" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_imageMaskColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.ImageMaskColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel Spacing="5">
            <StackPanel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding
                        Converter="{StaticResource BackgroundModeCompareConverter}"
                        ConverterParameter="Image"
                        Path="BackgroundMode"
                        Source="{x:Static const1:Data.ConfigEntry}" />
                    <Binding Path="EnableImageMask" Source="{x:Static const1:Data.ConfigEntry}" />
                </MultiBinding>
            </StackPanel.IsVisible>
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_imageMaskOpacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding ImageMaskOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding ImageMaskOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Acrylic'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_acrylicColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.BackgroundSolidColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Acrylic'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_opacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding AcrylicOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding AcrylicOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Blur'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_blurColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.BackgroundSolidColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Blur'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_opacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding BlurOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding BlurOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Mica'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_micaColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.BackgroundSolidColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='Mica'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_opacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding MicaOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding MicaOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='!Default'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_controlOpacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding ControlOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding ControlOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel IsVisible="{Binding BackgroundMode, Source={x:Static const1:Data.ConfigEntry}, Converter={StaticResource BackgroundModeCompareConverter}, ConverterParameter='!Default'}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_translucentControlOpacity}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider
                    Grid.Column="0"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding TranslucentControlOpacity, Source={x:Static const1:Data.ConfigEntry}}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="6,0,0,0"
                    Text="{Binding TranslucentControlOpacity, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:P0}}"
                    VerticalAlignment="Center"
                    Width="40" />
            </Grid>
        </StackPanel>
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_enableCustomForegroundColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding EnableCustomForegroundColor, Source={x:Static const1:Data.ConfigEntry}}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding EnableCustomForegroundColor, Source={x:Static const1:Data.ConfigEntry}}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_foregroundColor}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <controls:FluentColorPicker
                Color="{Binding Data.ConfigEntry.ForegroundColor}"
                ColorSpectrumShape="Box"
                HorizontalAlignment="Stretch"
                SelectedIndex="1">
                <controls:FluentColorPicker.Palette>
                    <FluentColorPalette />
                </controls:FluentColorPicker.Palette>
            </controls:FluentColorPicker>
        </StackPanel>
        <StackPanel IsVisible="{Binding IsWindows}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_disableSystemWindowBorder}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding EnableManagedWindowDecorationsOnWindows, Source={x:Static const1:Data.ConfigEntry}}" />
        </StackPanel>
        <StackPanel IsVisible="{Binding IsWindowBorderCustomizationSupported}" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_enableWindowBorder}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding EnableManagedWindowBorderOnWindows, Source={x:Static const1:Data.ConfigEntry}}" />
        </StackPanel>
        <Border Margin="0,-5,0,0">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                    <Binding Path="IsLinux" />
                    <Binding Path="EnableManagedWindowDecorationsOnWindows" Source="{x:Static const1:Data.ConfigEntry}" />
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel IsVisible="{Binding EnableManagedWindowBorderOnWindows, Source={x:Static const1:Data.ConfigEntry}}" Spacing="5">
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_borderColor}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}" />
                <controls:FluentColorPicker
                    Color="{Binding Data.ConfigEntry.CustomWindowBorderColor}"
                    ColorSpectrumShape="Box"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="1">
                    <controls:FluentColorPicker.Palette>
                        <FluentColorPalette />
                    </controls:FluentColorPicker.Palette>
                </controls:FluentColorPicker>
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_borderCornerRadius}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="0,10,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider
                        Grid.Column="0"
                        Maximum="30"
                        Minimum="0"
                        Value="{Binding CustomWindowBorderCornerRadius, Source={x:Static const1:Data.ConfigEntry}}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Text="{Binding CustomWindowBorderCornerRadius, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:0}px}"
                        VerticalAlignment="Center"
                        Width="40" />
                </Grid>
                <Label
                    Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_borderThickness}}"
                    FontSize="13"
                    Foreground="{DynamicResource InnerForegroundColor}"
                    Margin="0,10,0,0" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider
                        Grid.Column="0"
                        IsSnapToTickEnabled="True"
                        Maximum="6"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding CustomWindowBorderThickness, Source={x:Static const1:Data.ConfigEntry}}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Text="{Binding CustomWindowBorderThickness, Source={x:Static const1:Data.ConfigEntry}, StringFormat={}{0:0}px}"
                        VerticalAlignment="Center"
                        Width="40" />
                </Grid>
            </StackPanel>
        </Border>
        <StackPanel Margin="0,0,0,0" Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.appearance_showWidgetBackground}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ui:InfinityToggleSwitch IsChecked="{Binding ShowWidgetBackground, Source={x:Static const1:Data.ConfigEntry}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
