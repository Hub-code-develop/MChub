<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="MChub.Views.Pages.SettingPages.Notification"
    x:DataType="settingPages:Notification"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settingPages="clr-namespace:MChub.Views.Pages.SettingPages"
    xmlns:ui="using:InfinityUI.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:MChub.Localization">
    <StackPanel Spacing="15">
        <StackPanel Spacing="5">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_notificationMethod}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <ComboBox
                HorizontalAlignment="Stretch"
                SelectedIndex="{Binding Data.ConfigEntry.NoticeWay}"
                SelectionChanged="SelectingItemsControl_OnSelectionChanged">
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_bubble}}" />
                <ComboBoxItem Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_card}}" />
            </ComboBox>
        </StackPanel>
        <StackPanel Spacing="15">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_notificationPermission}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_showSelectedAccount}}" />
                    <ui:InfinityToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowUsingAccountTip}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_showDragDropTip}}" />
                    <ui:InfinityToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowDragDropTip}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_showUpdateTip}}" />
                    <ui:InfinityToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowUpdateTip}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
        <StackPanel Spacing="15">
            <Label
                Content="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_optional}}"
                FontSize="13"
                Foreground="{DynamicResource InnerForegroundColor}" />
            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_showMinecraftNews}}" />
                    <ui:InfinityToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowMinecraftNews}" />
                </DockPanel>
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Left"
                        FontSize="14"
                        HorizontalAlignment="Left"
                        Text="{Translate {x:Static loc:SettingsLanguageManager+Keys.notification_showRecentPlays}}" />
                    <ui:InfinityToggleSwitch
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="{Binding Data.ConfigEntry.ShowRecentPlays}" />
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
