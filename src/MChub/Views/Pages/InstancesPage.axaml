<UserControl
    d:DesignHeight="450"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="MChub.Views.Pages.InstancesPage"
    x:DataType="pages:InstancesPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:classes="clr-namespace:MChub.Core.Minecraft.Classes;assembly=MChub.Core"
    xmlns:controls="https://github.com/tiouoo/TioUi.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="clr-namespace:MChub.Views.Pages"
    xmlns:widgets="clr-namespace:MChub.Views.Widgets"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="18,0,18,8">
        <widgets:InstanceListToolbar
            DockPanel.Dock="Top"
            Margin="0,0,0,10"
            ShowFolderFilter="True"
            ShowOpenInstancesTitle="False" />
        <!--  列头  -->
        <Grid
            ColumnDefinitions="42,*,96,86,Auto"
            DockPanel.Dock="Top"
            Height="30"
            Margin="12,0,12,2">
            <TextBlock
                Grid.Column="1"
                FontSize="11.5"
                Foreground="{DynamicResource InfinityMuted}"
                Margin="14,0,0,0"
                Text="游戏名称"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="2"
                FontSize="11.5"
                Foreground="{DynamicResource InfinityMuted}"
                HorizontalAlignment="Center"
                Text="版本"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="3"
                FontSize="11.5"
                Foreground="{DynamicResource InfinityMuted}"
                Text="游戏时长"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="4"
                FontSize="11.5"
                Foreground="{DynamicResource InfinityMuted}"
                HorizontalAlignment="Right"
                Margin="0,0,14,0"
                Text="操作"
                VerticalAlignment="Center" />
        </Grid>
        <controls:ScrollView
            Background="Transparent"
            Classes="Flat"
            DockPanel.Dock="Bottom"
            Name="MainScrollViewer">
            <ItemsRepeater
                ItemsSource="{Binding FilteredMinecraftInstances}"
                Margin="0,0,4,4"
                VerticalAlignment="Top">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate DataType="classes:MinecraftInstance">
                        <widgets:LauncherXInstanceRow />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </controls:ScrollView>
    </DockPanel>
</UserControl>
