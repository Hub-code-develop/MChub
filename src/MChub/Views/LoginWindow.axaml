<faApp:FAAppWindow
    CanResize="False"
    Height="430"
    Title="登录 MChub"
    Width="580"
    WindowStartupLocation="CenterScreen"
    x:Class="MChub.Views.LoginWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:faApp="using:FluentAvalonia.UI.Windowing"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <faApp:FAAppWindow.Resources>
        <SolidColorBrush Color="Transparent" x:Key="TitleBarBackgroundColor" />
    </faApp:FAAppWindow.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="必须登录微软正版账号" />
            <TextBlock Opacity="0.75" TextWrapping="Wrap"
                       Text="按合规要求，MChub 需要绑定一个微软正版账号后才能使用。登录凭证只保存在本机，不会上传。" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0" Spacing="10" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Opacity="0.85" TextWrapping="Wrap" Text="正在获取登录验证码…" />

            <StackPanel x:Name="CodePanel" IsVisible="False" Spacing="6">
                <TextBlock Opacity="0.6" Text="一次性验证码" />
                <TextBlock x:Name="CodeText" FontSize="32" FontWeight="Bold" />
                <TextBlock x:Name="UrlText" Opacity="0.8" TextWrapping="Wrap" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                    <Button Click="CopyCode" Content="复制验证码" />
                    <Button Click="OpenUrl" Content="打开浏览器" />
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#C93635" IsVisible="False" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RetryButton" Click="Retry" Content="重新获取验证码" IsVisible="False" />
            <Button Click="ImportFromOtherLaunchers" Content="从其他启动器导入" />
            <Button Click="Quit" Content="退出" />
        </StackPanel>
    </Grid>
</faApp:FAAppWindow>
