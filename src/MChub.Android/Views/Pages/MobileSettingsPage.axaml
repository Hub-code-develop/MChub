<UserControl
    x:Class="MChub.Mobile.Views.Pages.MobileSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:loc="using:MChub.Localization">
    <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">

            <Border
                Padding="14"
                CornerRadius="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsGeneral}}" />

                    <Grid
                        ColumnDefinitions="140,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="10">
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsLanguage}}" />
                        <TextBlock
                            x:Name="LanguageValue"
                            Grid.Row="0"
                            Grid.Column="1"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsTheme}}" />
                        <TextBlock
                            x:Name="ThemeValue"
                            Grid.Row="1"
                            Grid.Column="1"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsVersion}}" />
                        <TextBlock
                            x:Name="VersionValue"
                            Grid.Row="2"
                            Grid.Column="1"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsStorageTitle}}" />
                        <TextBlock
                            x:Name="StorageValue"
                            Grid.Row="3"
                            Grid.Column="1"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 运行时状态：用 Fluent 的 FAInfoBar 表达严重程度，状态本身取自真实的探测结果。 -->
            <fa:FAInfoBar
                x:Name="RuntimeInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />

            <Button
                x:Name="ImportRuntimeButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="{Translate {x:Static loc:MobileLanguageManager+Keys.mobile_settingsRuntimeImport}}"
                Click="ImportRuntime_OnClick" />

            <TextBlock
                x:Name="ImportStatusText"
                IsVisible="False"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock
                x:Name="CoreStatusText"
                IsVisible="False"
                FontSize="12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
