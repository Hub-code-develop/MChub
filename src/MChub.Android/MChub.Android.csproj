<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <!-- Android 命名空间与 Android.* 平台命名空间同名会造成解析歧义，这里把根命名空间独立出来。 -->
        <RootNamespace>MChub.Mobile</RootNamespace>
        <AssemblyName>MChub.Android</AssemblyName>
        <!-- Android 8.0：libjvm.so 需要在应用私有目录中以 dlopen 方式加载。 -->
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationId>hub.code.MChub</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <!-- 只出 64 位 ARM：必须在工程内声明而不是命令行 -p，
             否则该全局属性会泄漏到 Core/Localization 等引用工程，
             让它们的 obj 输出被塞进 android-arm64 子目录并触发 MSB3030 找不到 dll。 -->
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <Description>MChub for Android</Description>
    </PropertyGroup>

    <!-- 桌面端的 LINUX / MACOS 编译常量对移动端无意义；且 Android 上 OperatingSystem.IsLinux()
         会返回 true，常量残留会把代码引进桌面 Linux 分支，这里显式剔除。 -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants.Replace('LINUX','').Replace('MACOS',''))</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Android"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!-- UI 主题 = CodeHub-FluentUI（CodeHub 维护的 FluentAvalonia 分支，程序集名仍为 FluentAvalonia.dll），
             与桌面端 MChub 同栈。该主题自带基础控件模板（ControlThemes/Controls.axaml 覆盖 Button/ListBox/
             ScrollViewer 等），因此不再需要 Avalonia.Themes.Fluent，也不再引 CodeHub-OreUI。 -->
        <PackageReference Include="CodeHub-FluentUI"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <!-- 移动端要解压 Amethyst/Pojav 系的运行时归档（.tar.xz）：XZStream 来自 SharpCompress。 -->
        <PackageReference Include="SharpCompress"/>
        <!-- 显式引用：{Translate} 标记扩展由 Irihi.Lingua.Core 注册进 Avalonia 默认 xmlns。 -->
        <PackageReference Include="Irihi.Lingua"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MChub.Core\MChub.Core.csproj"/>
        <ProjectReference Include="..\MChub.Localization\MChub.Localization.csproj"/>
    </ItemGroup>

    <!-- Java 后端（hub.code.mchub.runtime.*）：运行时校验与启动编排，随 APK 编译为 dex 供 C# 经 JNI 调用。
         创建 JVM 的 native 层由 Native/ 下的 C++ 实现、用 Android NDK 构建（见 Native/build-android.sh）；
         未构建时 LauncherBridge 会明确报错，不静默失败。 -->
    <ItemGroup>
        <AndroidJavaSource Include="Java\**\*.java"/>
    </ItemGroup>

    <!-- native 启动层产物：存在就随 APK 打进 lib/arm64-v8a/，不存在则跳过（界面仍可用，只如实提示未接入）。 -->
    <ItemGroup>
        <AndroidNativeLibrary Include="Native\out\arm64-v8a\libmchubjvm.so"
                              Condition="Exists('Native\out\arm64-v8a\libmchubjvm.so')"/>

        <!-- 移动端自带的「java 命令」（Forge / NeoForge / OptiFine 的安装处理器要靠它跑）。
             它是**可执行文件**，不是共享库：
               * 不能进启动期 JNI 预加载 —— 否则 linker 会把它当动态库 dlopen 并报「不是共享库」；
               * 放在 lib/<abi>/ 是 Android 上唯一既允许 execve 又受系统保护的位置
                 （应用私有目录自 targetSdk 29 起禁止 execve）。
             execve 不受「不做 JNI 预加载」影响，两者互不干扰。 -->
        <AndroidNativeLibraryNoJniPreload Include="Native\out\arm64-v8a\libmchubjava.so"
                                          Condition="Exists('Native\out\arm64-v8a\libmchubjava.so')"/>
    </ItemGroup>

    <!--
      预置的移动端运行时（RuntimeAssets/）：由 .github/workflows/build-android.yml 在打包前
      从本仓库 release（mobile-runtime-v1）下载并展开，因此**最终 APK 自带全部运行组件，
      用户装机即用、无需再联网下载**。

        RuntimeAssets/natives.zip          → 打进 assets/runtime/natives.zip（原生库，首次启动解到私有目录）
        RuntimeAssets/jre/<major>/*.tar.xz → 打进 assets/runtime/jre/（首次启动解压到应用私有目录）
        RuntimeAssets/lwjgl/<ver>/*.jar    → 打进 assets/runtime/lwjgl/（移动端补丁版 LWJGL）
        RuntimeAssets/lwjgl-natives/<ver>/*.so → 打进 assets/runtime/lwjgl-natives/（按实例版本解压）

      ⚠ **原生库一律不进 APK 的 lib/<abi>/**：平台会对那里的每个 .so 做 16 KB 页对齐检查，
      不达标就强制 App 跑「页面大小兼容模式」并在启动时弹警告。这批库多是上游预编译产物
      （AAR / JRE 自带），ELF 段对齐是 4 KB 且无法重链接 —— 实测放进 lib/ 必弹窗。
      另外放进 lib/ 还会被 .NET Android 在启动时全部 System.loadLibrary，触发上游 native 的
      JNI_OnLoad（它们要 FindClass 自己的 Java 侧，那个类在我们这儿不存在）→ SIGABRT。
      所以：以 zip 预置 → 运行时解到私有目录 → 由 JREUtils.loadNativeLayer（JNI 部分）
      与 PojavRuntimeSupport（GL 翻译层等，按绝对路径 dlopen）装载。

      本地开发时该目录不存在，整组条目自动跳过（Condition），不影响普通构建。
      要在本地也打出「自带运行时」的包，先跑一次 scripts/prepare-android-runtime.sh 装配。
      目录本身不入库（见 .gitignore），CI 与本地都靠脚本/工作流现装配。
    -->
    <ItemGroup Condition="Exists('RuntimeAssets')">
        <!-- 原生库打 zip：assets 里直接放 .so 会被 .NET Android 检查 ABI（路径无 ABI 名 → XA4301）。 -->
        <AndroidAsset Include="RuntimeAssets/natives.zip"
                      Link="Assets/runtime/natives.zip"
                      Condition="Exists('RuntimeAssets/natives.zip')"/>

        <AndroidAsset Include="RuntimeAssets/jre/**/*.tar.xz"
                      Link="Assets/runtime/jre/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- LWJGL jar 以 zip 形式预置：assets 里的 .jar 会被 .NET Android 当成
             AndroidJavaLibrary 参与 dex，两套版本同名即报 XA1014（见 build-android.yml）。 -->
        <AndroidAsset Include="RuntimeAssets/lwjgl/*.zip"
                      Link="Assets/runtime/lwjgl/%(Filename)%(Extension)"/>
        <!-- LWJGL 原生库同样以 zip 预置：assets 里的 .so 会被 .NET Android 检查 ABI（报 XA4301），
             且两套版本有同名 .so。运行时按实例需要的版本解压到私有目录。 -->
        <AndroidAsset Include="RuntimeAssets/lwjgl-natives/*.zip"
                      Link="Assets/runtime/lwjgl-natives/%(Filename)%(Extension)"/>
        <AndroidAsset Include="RuntimeAssets/manifest.json"
                      Link="Assets/runtime/manifest.json"
                      Condition="Exists('RuntimeAssets/manifest.json')"/>
    </ItemGroup>

    <!--
      ⚠ 上游 native 的 JNI_OnLoad 依赖（补 Java 占位类的依据，改运行组件时必看）：

      .NET Android 默认会把 APK 里所有 native 库在启动时 System.loadLibrary 一遍 —— 目的是让各自的
      JNI_OnLoad 跑起来。而 Pojav 系 native 的 JNI_OnLoad 会去 FindClass / RegisterNatives
      **它们自己的 Java 侧**，这些类在我们的启动器里并不存在：

        libbytehook.so   → com.bytedance.android.bytehook.ByteHook（RegisterNatives 10 个方法）
        libSDL3.so       → org.libsdl.app.{SDLActivity, SDLInputConnection, SDLAudioManager,
                                          SDLControllerManager, HIDDeviceManager}
        libpojavexec.so  → org.lwjgl.glfw.CallbackBridge

      缺类时 FindClass 返回 null 并**留下 pending exception**，紧接着 native 里下一个 JNI 调用
      （NewGlobalRef / FindClass）就会被 CheckJNI 直接判死 → SIGABRT（实测过）。

      现在已经从两头都堵上：
        ① 这些库不再进 lib/（见上面 RuntimeAssets 段落），不在启动期被 loadLibrary，
           而是运行时按绝对路径 System.load / dlopen；
        ② 需要 JNI 注册的那两个类仍有占位类兜底 —— Java/org/lwjgl/glfw/CallbackBridge.java、
           Java/com/bytedance/android/bytehook/ByteHook.java（签名与上游严格对齐，方法体不会被调用）。
    -->

    <ItemGroup>
        <AndroidResource Include="..\..\assets\MChub.png" Link="Resources\drawable\mchub_icon.png"/>
    </ItemGroup>

</Project>
