<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <!-- Android 命名空间与 Android.* 平台命名空间同名会造成解析歧义，这里把根命名空间独立出来。 -->
        <RootNamespace>MChub.Mobile</RootNamespace>
        <AssemblyName>MChub.Android</AssemblyName>
        <!-- Android 8.0：libjvm.so 需要在应用私有目录中以 dlopen 方式加载。 -->
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationId>hub.code.MChub</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <!-- 只出 64 位 ARM：必须在工程内声明而不是命令行 -p，
             否则该全局属性会泄漏到 Core/Localization 等引用工程，
             让它们的 obj 输出被塞进 android-arm64 子目录并触发 MSB3030 找不到 dll。 -->
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <Description>MChub for Android</Description>
    </PropertyGroup>

    <!-- 桌面端的 LINUX / MACOS 编译常量对移动端无意义；且 Android 上 OperatingSystem.IsLinux()
         会返回 true，常量残留会把代码引进桌面 Linux 分支，这里显式剔除。 -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants.Replace('LINUX','').Replace('MACOS',''))</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Android"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!-- UI 主题 = CodeHub-FluentUI（CodeHub 维护的 FluentAvalonia 分支，程序集名仍为 FluentAvalonia.dll），
             与桌面端 MChub 同栈。该主题自带基础控件模板（ControlThemes/Controls.axaml 覆盖 Button/ListBox/
             ScrollViewer 等），因此不再需要 Avalonia.Themes.Fluent，也不再引 CodeHub-OreUI。 -->
        <PackageReference Include="CodeHub-FluentUI"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <!-- 显式引用：{Translate} 标记扩展由 Irihi.Lingua.Core 注册进 Avalonia 默认 xmlns。 -->
        <PackageReference Include="Irihi.Lingua"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MChub.Core\MChub.Core.csproj"/>
        <ProjectReference Include="..\MChub.Localization\MChub.Localization.csproj"/>
    </ItemGroup>

    <!-- Java 后端（hub.code.mchub.runtime.*）：运行时校验与启动编排，随 APK 编译为 dex 供 C# 经 JNI 调用。
         创建 JVM 的 native 层（libmchubjvm.so）需 Android NDK 构建；
         未接入时 LauncherBridge 会明确报错，不静默失败。 -->
    <ItemGroup>
        <AndroidJavaSource Include="Java\**\*.java"/>
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="..\..\assets\MChub.png" Link="Resources\drawable\mchub_icon.png"/>
    </ItemGroup>

</Project>
