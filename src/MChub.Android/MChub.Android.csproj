<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <!-- Android 命名空间与 Android.* 平台命名空间同名会造成解析歧义，这里把根命名空间独立出来。 -->
        <RootNamespace>MChub.Mobile</RootNamespace>
        <AssemblyName>MChub.Android</AssemblyName>
        <!-- Android 8.0：libjvm.so 需要在应用私有目录中以 dlopen 方式加载。 -->
        <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationId>hub.code.MChub</ApplicationId>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <!-- 只出 64 位 ARM：必须在工程内声明而不是命令行 -p，
             否则该全局属性会泄漏到 Core/Localization 等引用工程，
             让它们的 obj 输出被塞进 android-arm64 子目录并触发 MSB3030 找不到 dll。 -->
        <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
        <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
        <Description>MChub for Android</Description>
    </PropertyGroup>

    <!-- 桌面端的 LINUX / MACOS 编译常量对移动端无意义；且 Android 上 OperatingSystem.IsLinux()
         会返回 true，常量残留会把代码引进桌面 Linux 分支，这里显式剔除。 -->
    <PropertyGroup>
        <DefineConstants>$(DefineConstants.Replace('LINUX','').Replace('MACOS',''))</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Android"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
        <!-- UI 主题 = CodeHub-FluentUI（CodeHub 维护的 FluentAvalonia 分支，程序集名仍为 FluentAvalonia.dll），
             与桌面端 MChub 同栈。该主题自带基础控件模板（ControlThemes/Controls.axaml 覆盖 Button/ListBox/
             ScrollViewer 等），因此不再需要 Avalonia.Themes.Fluent，也不再引 CodeHub-OreUI。 -->
        <PackageReference Include="CodeHub-FluentUI"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <!-- 移动端要解压 Amethyst/Pojav 系的运行时归档（.tar.xz）：XZStream 来自 SharpCompress。 -->
        <PackageReference Include="SharpCompress"/>
        <!-- 显式引用：{Translate} 标记扩展由 Irihi.Lingua.Core 注册进 Avalonia 默认 xmlns。 -->
        <PackageReference Include="Irihi.Lingua"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MChub.Core\MChub.Core.csproj"/>
        <ProjectReference Include="..\MChub.Localization\MChub.Localization.csproj"/>
    </ItemGroup>

    <!-- Java 后端（hub.code.mchub.runtime.*）：运行时校验与启动编排，随 APK 编译为 dex 供 C# 经 JNI 调用。
         创建 JVM 的 native 层由 Native/ 下的 C++ 实现、用 Android NDK 构建（见 Native/build-android.sh）；
         未构建时 LauncherBridge 会明确报错，不静默失败。 -->
    <ItemGroup>
        <AndroidJavaSource Include="Java\**\*.java"/>
    </ItemGroup>

    <!-- native 启动层产物：存在就随 APK 打进 lib/arm64-v8a/，不存在则跳过（界面仍可用，只如实提示未接入）。 -->
    <ItemGroup>
        <AndroidNativeLibrary Include="Native\out\arm64-v8a\libmchubjvm.so"
                              Condition="Exists('Native\out\arm64-v8a\libmchubjvm.so')"/>
    </ItemGroup>

    <!--
      预置的移动端运行时（RuntimeAssets/）：由 .github/workflows/build-android.yml 在打包前
      从本仓库 release（mobile-runtime-v1）下载并展开，因此**最终 APK 自带全部运行组件，
      用户装机即用、无需再联网下载**。

        RuntimeAssets/libs/arm64-v8a/*.so   → 打进 lib/arm64-v8a/（安装时系统解压到 nativeLibraryDir）
        RuntimeAssets/jre/<major>/*.tar.xz  → 打进 assets/runtime/jre/（首次启动解压到应用私有目录）
        RuntimeAssets/lwjgl/<ver>/*.jar     → 打进 assets/runtime/lwjgl/（移动端补丁版 LWJGL）
        RuntimeAssets/lwjgl-natives/<ver>/*.so → 打进 assets/runtime/lwjgl-natives/（按实例版本解压）

      本地开发时该目录不存在，整组条目自动跳过（Condition），不影响普通构建。
      目录本身不入库（见 .gitignore），只在 CI 装配。
    -->
    <ItemGroup Condition="Exists('RuntimeAssets')">
        <AndroidNativeLibrary Include="RuntimeAssets/libs/arm64-v8a/*.so"/>

        <AndroidAsset Include="RuntimeAssets/jre/**/*.tar.xz"
                      Link="Assets/runtime/jre/%(RecursiveDir)%(Filename)%(Extension)"/>
        <!-- LWJGL jar 以 zip 形式预置：assets 里的 .jar 会被 .NET Android 当成
             AndroidJavaLibrary 参与 dex，两套版本同名即报 XA1014（见 build-android.yml）。 -->
        <AndroidAsset Include="RuntimeAssets/lwjgl/*.zip"
                      Link="Assets/runtime/lwjgl/%(Filename)%(Extension)"/>
        <!-- LWJGL 原生库同样以 zip 预置：assets 里的 .so 会被 .NET Android 检查 ABI（报 XA4301），
             且两套版本有同名 .so。运行时按实例需要的版本解压到私有目录。 -->
        <AndroidAsset Include="RuntimeAssets/lwjgl-natives/*.zip"
                      Link="Assets/runtime/lwjgl-natives/%(Filename)%(Extension)"/>
        <AndroidAsset Include="RuntimeAssets/manifest.json"
                      Link="Assets/runtime/manifest.json"
                      Condition="Exists('RuntimeAssets/manifest.json')"/>
    </ItemGroup>

    <ItemGroup>
        <AndroidResource Include="..\..\assets\MChub.png" Link="Resources\drawable\mchub_icon.png"/>
    </ItemGroup>

</Project>
