<Styles xmlns="https://github.com/avaloniaui" xmlns:ui="using:InfinityUI.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        infinityUI 控件主题。
        所有模板自绘：直角（CornerRadius 恒为 0）、无投影、无渐变，
        层级仅靠 1px 描边与灰阶区分；彩色只允许出现在 Danger / Warning / Success 语义处。
    -->

    <Styles.Resources>
        <!--  ==================== 按钮  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityButton}" TargetType="ui:InfinityButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InfOnSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InfBorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{DynamicResource InfControlPadding}" />
            <Setter Property="Height" Value="{DynamicResource InfControlHeight}" />
            <Setter Property="FontSize" Value="{DynamicResource InfFontSize}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        Name="PART_Root">
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Margin="{TemplateBinding Padding}"
                            Name="PART_ContentPresenter"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <!--  主操作：主题色实心，反色文字  -->
            <Style Selector="^[Variant=Primary]">
                <Setter Property="Background" Value="{DynamicResource InfAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource InfOnAccent}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[Variant=Primary]:pointerover /template/ Border#PART_Root">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^[Variant=Primary]:pressed /template/ Border#PART_Root">
                <Setter Property="Opacity" Value="0.7" />
            </Style>

            <!--  次操作：描边  -->
            <Style Selector="^[Variant=Secondary]:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            </Style>
            <Style Selector="^[Variant=Secondary]:pressed /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceAlt}" />
            </Style>

            <!--  纯文字  -->
            <Style Selector="^[Variant=Ghost]">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource InfMuted}" />
            </Style>
            <Style Selector="^[Variant=Ghost]:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            </Style>
            <Style Selector="^[Variant=Ghost]:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource InfOnSurface}" />
            </Style>

            <!--  破坏性操作：全库唯一允许用红的按钮  -->
            <Style Selector="^[Variant=Danger]">
                <Setter Property="Background" Value="{DynamicResource InfDanger}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^[Variant=Danger]:pointerover /template/ Border#PART_Root">
                <Setter Property="Opacity" Value="0.85" />
            </Style>

            <!--  紧凑 / 禁用  -->
            <Style Selector="^[IsCompact=True]">
                <Setter Property="Height" Value="{DynamicResource InfControlHeightCompact}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="FontSize" Value="{DynamicResource InfFontSizeSmall}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="Arrow" />
            </Style>
        </ControlTheme>

        <!--  ==================== 图标按钮  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityIconButton}" TargetType="ui:InfinityIconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InfMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityIconButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="0"
                        Height="{TemplateBinding BoxSize}"
                        Name="PART_Root"
                        Width="{TemplateBinding BoxSize}">
                        <TextBlock
                            FontFamily="{TemplateBinding GlyphFontFamily}"
                            FontSize="{TemplateBinding IconSize}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalAlignment="Center"
                            IsVisible="{TemplateBinding HasGlyph}"
                            Text="{TemplateBinding Glyph}"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource InfOnSurface}" />
            </Style>
            <Style Selector="^:pressed /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceAlt}" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>

        <!--  ==================== 直角开关  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityToggleSwitch}" TargetType="ui:InfinityToggleSwitch">
            <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InfBorderStrong}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityToggleSwitch">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="0"
                            Height="{TemplateBinding TrackHeight}"
                            Name="PART_Track"
                            VerticalAlignment="Center"
                            Width="{TemplateBinding TrackWidth}">
                            <Border
                                Background="{DynamicResource InfMuted}"
                                CornerRadius="0"
                                Height="12"
                                HorizontalAlignment="Left"
                                Margin="3,0,0,0"
                                Name="PART_Thumb"
                                Width="14" />
                        </Border>
                        <TextBlock
                            FontSize="{DynamicResource InfFontSizeSmall}"
                            Foreground="{DynamicResource InfMuted}"
                            IsVisible="False"
                            Name="PART_OnContent"
                            Text="{TemplateBinding OnContent}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            FontSize="{DynamicResource InfFontSizeSmall}"
                            Foreground="{DynamicResource InfMuted}"
                            Name="PART_OffContent"
                            Text="{TemplateBinding OffContent}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:checked /template/ Border#PART_Track">
                <Setter Property="Background" Value="{DynamicResource InfAccent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InfAccent}" />
            </Style>
            <Style Selector="^:checked /template/ Border#PART_Thumb">
                <Setter Property="Background" Value="{DynamicResource InfOnAccent}" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Margin" Value="0,0,3,0" />
            </Style>
            <Style Selector="^:pointerover /template/ Border#PART_Track">
                <Setter Property="BorderBrush" Value="{DynamicResource InfOnSurface}" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#PART_OnContent">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^:checked /template/ TextBlock#PART_OffContent">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.4" />
            </Style>
        </ControlTheme>

        <!--  ==================== 卡片  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityCard}" TargetType="ui:InfinityCard">
            <Setter Property="Background" Value="{DynamicResource InfSurfaceAlt}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InfBorder}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityCard">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Name="PART_Root">
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            Margin="{TemplateBinding ContentPadding}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^[IsRaised=True]">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            </Style>
            <Style Selector="^[ShowBorder=False] /template/ Border#PART_Root">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ControlTheme>

        <!--  ==================== 导航项  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityNavItem}" TargetType="ui:InfinityNavItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource InfMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="{DynamicResource InfFontSize}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityNavItem">
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="0"
                        Name="PART_Root">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border
                                Background="{DynamicResource InfAccent}"
                                IsVisible="{TemplateBinding IsActive}"
                                Name="PART_Indicator"
                                Width="3" />
                            <StackPanel
                                Grid.Column="1"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                                <TextBlock
                                    FontFamily="{TemplateBinding GlyphFontFamily}"
                                    FontSize="16"
                                    Foreground="{TemplateBinding Foreground}"
                                    IsVisible="{TemplateBinding HasGlyph}"
                                    Text="{TemplateBinding Glyph}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{TemplateBinding Content}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfSurfaceRaised}" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource InfOnSurface}" />
            </Style>
            <Style Selector="^[IsActive=True]">
                <Setter Property="Background" Value="{DynamicResource InfAccent}" />
                <Setter Property="Foreground" Value="{DynamicResource InfOnAccent}" />
            </Style>
            <Style Selector="^[IsActive=True]:pointerover /template/ Border#PART_Root">
                <Setter Property="Background" Value="{DynamicResource InfAccent}" />
            </Style>
            <Style Selector="^[IsActive=True]:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource InfOnAccent}" />
            </Style>
            <Style Selector="^[ShowIndicator=False] /template/ Border#PART_Indicator">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>

        <!--  ==================== Metro 通知卡片  ====================  -->
        <ControlTheme x:Key="{x:Type ui:InfinityToast}" TargetType="ui:InfinityToast">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ui:InfinityToast">
                    <Border
                        Background="{DynamicResource InfSurfaceRaised}"
                        BorderBrush="{DynamicResource InfBorder}"
                        BorderThickness="1"
                        CornerRadius="0"
                        Name="PART_Root">
                        <Grid ColumnDefinitions="6,*,Auto">
                            <!--  左侧语义色条：红 / 黄 / 绿 / 灰  -->
                            <Border Background="{TemplateBinding LevelBrush}" Grid.Column="0" Name="PART_Accent" />
                            <StackPanel
                                Grid.Column="1"
                                Margin="12,10,8,10"
                                Spacing="3"
                                VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{TemplateBinding LevelBrush}"
                                        Text="{TemplateBinding Glyph}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource InfMuted}"
                                        Text="{TemplateBinding Title}"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{DynamicResource InfOnSurface}"
                                    Text="{TemplateBinding Message}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Grid.Column="2"
                                Height="26"
                                Margin="0,0,4,0"
                                Name="PART_Close"
                                Padding="0"
                                VerticalAlignment="Top"
                                Width="26">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource InfMuted}"
                                    HorizontalAlignment="Center"
                                    Text="✕"
                                    VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>
</Styles>
